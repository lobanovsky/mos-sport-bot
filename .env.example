TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=
LISTEN_ADDR=:8088
# mos-sport-backend живёт на отдельном сервере — публичный адрес его HTTP API
# (subscribe/unsubscribe/list/status). Обязательна: без бэкенда бот бесполезен.
BACKEND_API_URL=
REQUEST_TIMEOUT=10s
# ID чатов (через запятую), которым доступна админская команда /subscribers.
# Свой chat_id можно узнать, например, у @userinfobot. Необязательна: если
# пусто, команда недоступна никому.
ADMIN_CHAT_IDS=
