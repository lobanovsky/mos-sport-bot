TELEGRAM_BOT_TOKEN=
WEBHOOK_SECRET=
LISTEN_ADDR=:8088
SUBSCRIBERS_FILE=/data/subscribers.json
# mos-sport-backend живёт на отдельном сервере — публичный адрес его GET /status.
